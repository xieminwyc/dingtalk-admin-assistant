# ========================================
# 必填：钉钉应用凭证
# 从钉钉开发者后台「应用凭证」页面获取
# ========================================
DINGTALK_CLIENT_ID=your-dingtalk-client-id
DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret
# 企业 corpId，用于生成 OA 审批直达链接。在钉钉开放平台应用基本信息页面获取。
DINGTALK_CORP_ID=your-dingtalk-corp-id

# ========================================
# 可选：数据库连接（暂未强制依赖）
# ========================================
DATABASE_URL=postgresql://localhost:5432/dingtalk_admin_assistant

# ========================================
# 可选：外部 RAG 检索接口
# 留空则跳过 RAG 检索，只走本地知识卡片
# ========================================
RAG_API_URL=
RAG_API_KEY=
# RAG API 请求超时时间（毫秒），默认30000（30秒）
RAG_API_TIMEOUT=30000
# RAG API 请求失败时的重试次数，默认2
RAG_API_RETRY_COUNT=2

# ========================================
# 可选：意图分析模型（SiliconFlow 兼容接口）
# 不填则使用本地规则模式，无需调用 LLM
# ========================================
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=
